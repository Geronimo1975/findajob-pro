# findajob.pro backend — environment template.
#
# LOCAL DEV: copy to `backend/.env` (gitignored) and fill in. `config/env.py`
# also reads the repository-root `.env` as a fallback, and the real process
# environment always wins over both.
#
# PRODUCTION (VPS): copy to the REPOSITORY ROOT as `/root/findajob/.env`, i.e.
# next to `docker-compose.yml`. That single file is used twice — Compose reads
# it for `${VAR}` interpolation (POSTGRES_PASSWORD, REDIS_PASSWORD) AND it is
# the `api` service's `env_file`, so the secrets have exactly one home. Mode
# 0600. See deploy/README.md.
#
# Select the settings module with DJANGO_SETTINGS_MODULE:
#   config.settings.dev   (default for manage.py)
#   config.settings.prod  (default for gunicorn / config.wsgi)
#   config.settings.test  (pytest.ini; `manage.py test` should be pointed here)
#
# The Docker deployment sets DJANGO_SETTINGS_MODULE=config.settings.prod in
# deploy/docker-compose.yml, where it overrides anything written here.
DJANGO_SETTINGS_MODULE=config.settings.prod

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
# config.settings.prod REFUSES TO BOOT on the built-in development key.
SECRET_KEY=

DEBUG=False

# Comma-separated. Required in production.
ALLOWED_HOSTS=findajob.pro,www.findajob.pro

# Comma-separated https origins the browser actually uses. Required in
# production — the session-cookie CSRF scheme depends on it.
CSRF_TRUSTED_ORIGINS=https://findajob.pro,https://www.findajob.pro

# Optional: comma-separated addresses for unhandled-exception mail.
# Django 6.0 wants plain addresses, not (name, address) tuples.
DJANGO_ADMINS=

LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Database — PostgreSQL 16
# ---------------------------------------------------------------------------
# Leaving POSTGRES_DB empty selects the SQLite fallback (local dev / tests only).
#
# POSTGRES_DB / POSTGRES_USER / POSTGRES_PASSWORD are ALSO read by Compose to
# initialise the `db` container (deploy/docker-compose.yml). POSTGRES_PASSWORD
# has no default there: `docker compose up` fails loudly if it is empty.
# Generate with:  openssl rand -hex 32
POSTGRES_DB=findajob
POSTGRES_USER=findajob
POSTGRES_PASSWORD=
# Compose overrides both of these with the in-network service address, so a
# value left over from a laptop .env cannot break the container.
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60
POSTGRES_CONNECT_TIMEOUT=5

# ---------------------------------------------------------------------------
# Cache — Redis. CACHE ONLY: sessions live in Postgres, so a Redis outage
# throttles login attempts loosely instead of logging everybody out.
# Leave empty to fall back to in-process locmem (dev/test only).
# ---------------------------------------------------------------------------
#
# REQUIRED IN PRODUCTION. The Redis container runs with `--requirepass`; an
# unauthenticated cache was flagged as a release blocker. `docker compose up`
# refuses to start without this value.
#
# It is embedded in a URL, so generate one that needs no percent-encoding:
#   openssl rand -hex 32
REDIS_PASSWORD=

# Compose OVERRIDES this with redis://:${REDIS_PASSWORD}@redis:6379/0 so the
# password has a single home. The literal below is only for running Django
# outside Docker against a local, passwordless Redis.
# Leave empty to fall back to in-process locmem (dev/test only).
REDIS_URL=redis://redis:6379/0
CACHE_KEY_PREFIX=findajob
CACHE_DEFAULT_TIMEOUT=300
REDIS_CONNECT_TIMEOUT=2
REDIS_SOCKET_TIMEOUT=2

# ---------------------------------------------------------------------------
# Email — Brevo via django-anymail
# ---------------------------------------------------------------------------
# Login is a 6-digit email OTP sent SYNCHRONOUSLY inside the request. With
# DEBUG=False, `manage.py check` ERRORS (findajob.E001/E002/E003) when the
# backend is console/dummy/locmem or the API key is empty — an empty mail
# config must never produce a green UI and zero delivered codes.
EMAIL_BACKEND=anymail.backends.brevo.EmailBackend
BREVO_API_KEY=
EMAIL_TIMEOUT=5
DEFAULT_FROM_EMAIL=findajob.pro <noreply@findajob.pro>
SERVER_EMAIL=findajob.pro <noreply@findajob.pro>

# Signature secret for POST /webhooks/email/brevo/ (hard bounces + complaints
# -> SuppressedAddress). Empty makes the endpoint reject everything, and
# `check --deploy` warns (findajob.W001).
ANYMAIL_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Transport (production only; TLS terminates at Traefik)
# ---------------------------------------------------------------------------
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
USE_X_FORWARDED_HOST=False

# ---------------------------------------------------------------------------
# Sessions / uploads
# ---------------------------------------------------------------------------
SESSION_COOKIE_AGE=1209600
# In the container this is /app/media, a named volume (findajob_media_data),
# mode 0700. Leave empty to accept that default.
MEDIA_ROOT=
DATA_UPLOAD_MAX_MEMORY_SIZE=5242880

# ---------------------------------------------------------------------------
# Container runtime (read by backend/docker/entrypoint.sh and
# backend/docker/healthcheck.py). Every one of these has a working default —
# set them only to override.
# ---------------------------------------------------------------------------
# 1 = run collectstatic on container start. That also runs Django's system
# checks, which is what makes the boot-time mail check (findajob.E001-E003)
# actually abort the container instead of serving a green UI that mails nobody.
# Set to 0 ONLY for one-off `docker compose run` management commands.
DJANGO_COLLECTSTATIC=1

# Docker HEALTHCHECK. Liveness only: it must not consult PostgreSQL or Redis,
# or a database blip would restart-loop the whole API.
HEALTHCHECK_PORT=8000
HEALTHCHECK_TIMEOUT=4

# ---------------------------------------------------------------------------
# gunicorn (backend/gunicorn.conf.py). Defaults shown.
# ---------------------------------------------------------------------------
# The container publishes no ports; nginx reaches it over the docker network.
GUNICORN_BIND=0.0.0.0:8000

# gthread, not sync: the OTP email is sent synchronously inside the request.
GUNICORN_WORKER_CLASS=gthread
# 0/empty = auto (2 * CPU + 1, clamped to 2..6).
# CONSTRAINT: workers * threads must stay well under PostgreSQL's
# max_connections (100 by default), because CONN_MAX_AGE keeps connections
# open per worker. 6 * 4 = 24 is still comfortable.
GUNICORN_WORKERS=
GUNICORN_THREADS=4

GUNICORN_TIMEOUT=30
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_KEEPALIVE=15
GUNICORN_MAX_REQUESTS=1000
GUNICORN_MAX_REQUESTS_JITTER=100

GUNICORN_LOG_LEVEL=info
# The custom default access-log format logs the path WITHOUT the query string
# on purpose. Do not replace it with gunicorn's %(r)s.
GUNICORN_ACCESS_LOG_FORMAT=
