{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(ls:*)"
    ],
    "deny": [],
    "ask": []
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/tools/graphify_drift_notice.sh\" 2>/dev/null || true",
            "timeout": 10,
            "statusMessage": "Checking graphify drift"
          }
        ]
      }
    ]
  }
}
